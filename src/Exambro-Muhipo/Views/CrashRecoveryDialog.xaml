<Window x:Class="ExambroMuhipo.Views.CrashRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pemulihan Sesi Ujian"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Icon="/Assets/AppIcon.ico">

    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#EF4444" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.8" Direction="270" ShadowDepth="10"/>
        </Border.Effect>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Width="56" Height="56" Background="#1E293B" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,12" BorderBrush="#EF4444" BorderThickness="1.5" Padding="4">
                    <Image Source="/Assets/SchoolLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Pemberitahuan Pemulihan Sesi" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Exambro-Muhipo • SMA Muhammadiyah 1 Ponorogo" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Grid.Row="1" x:Name="MessageText"
                       Text="Aplikasi mendeteksi sesi ujian sebelumnya ditutup secara tidak wajar atau engine browser mengalami gangguan tak terduga. Lingkungan ujian tetap terkunci untuk menjaga integritas pelaksanaan ujian."
                       Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="18" TextAlignment="Center" Margin="0,0,0,16"/>

            <!-- Proktor Override Section -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Otorisasi Pengawas / Proktor (Untuk Keluar / Reset)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#475569" BorderThickness="1">
                        <PasswordBox x:Name="AdminPasswordInput" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#38BDF8" Padding="8,6" FontSize="14" BorderThickness="0"
                                     PreviewKeyDown="AdminPasswordInput_PreviewKeyDown" KeyDown="AdminPasswordInput_KeyDown"/>
                    </Border>
                    <TextBlock x:Name="ErrorText" Text="Password proktor salah." Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🔄 Muat Ulang Sesi" Height="40" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="RestartSession_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="🔒 Keluar (Otorisasi)" Height="40" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="UnlockAndExit_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
