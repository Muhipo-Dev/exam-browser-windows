<UserControl x:Class="ExambroMuhipo.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="1050"
             Background="#0B132B">

    <Grid Margin="32,16">
        <Grid.RowDefinitions>
            <!-- 1. Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Status Alert Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Main Server Config Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding BackToHomeCommand}" 
                        Background="#1E293B" Foreground="#E2E8F0" 
                        Padding="13,7" Margin="0,0,14,0" FontSize="12" FontWeight="Bold" 
                        BorderBrush="#475569" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅️ " FontSize="11"/>
                        <TextBlock Text="Kembali ke Beranda"/>
                    </StackPanel>
                </Button>

                <Border Width="36" Height="36" CornerRadius="8" Background="#1E293B" Padding="3" Margin="0,0,10,0" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                    <Image Source="/Assets/SchoolLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pengaturan Server Ujian" FontSize="17" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="SMA Muhammadiyah 1 Ponorogo • Khusus Proktor &amp; Tim IT" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <!-- Quick Start Exam Button -->
            <Button Grid.Column="2" Command="{Binding StartExamCommand}" 
                    Background="#10B981" Foreground="#FFFFFF" 
                    Padding="18,8" FontSize="12.5" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="12" Color="#10B981" Opacity="0.35" ShadowDepth="2"/>
                </Button.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚀 " FontSize="12"/>
                    <TextBlock Text="Simpan &amp; Mulai Ujian"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. STATUS NOTIFICATION BANNER -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,8" CornerRadius="8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                Background="{Binding IsStatusError, Converter={StaticResource BoolToStatusBgConverter}}"
                BorderBrush="{Binding IsStatusError, Converter={StaticResource BoolToStatusBorderConverter}}"
                BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- 3. MAIN CONFIGURATION FORM -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left" Width="880">
                <!-- CARD 1: INPUT ALAMAT IP SERVER UJIAN -->
                <Border Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🌐 " FontSize="16"/>
                            <TextBlock Text="Alamat IP / URL Server Ujian" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Masukkan alamat IP atau tautan server ujian sekolah (contoh: http://192.168.1.200:8080/cbt atau 192.168.0.10)." 
                                   Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,12"/>

                        <!-- Big Server IP Input Box -->
                        <Border Background="#0F172A" CornerRadius="8" BorderBrush="#38BDF8" BorderThickness="1.5" Padding="4" Margin="0,0,0,14">
                            <TextBox Text="{Binding ServerUrlInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="#38BDF8" CaretBrush="#38BDF8" 
                                     FontSize="15" FontWeight="Bold" FontFamily="Consolas" BorderThickness="0" Padding="10,6">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SaveServerConfigCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveServerConfigCommand}" 
                                    Background="#10B981" Foreground="#FFFFFF" 
                                    Padding="22,9" Margin="0,0,10,0" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#10B981" Opacity="0.35" ShadowDepth="2"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 " FontSize="12"/>
                                    <TextBlock Text="SIMPAN ALAMAT SERVER"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding TestProfileCommand}" 
                                    Background="#0D9488" Foreground="#FFFFFF" 
                                    Padding="16,9" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧪 " FontSize="12"/>
                                    <TextBlock Text="Uji Koneksi Server"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: GANTI PASSWORD ADMINISTRATOR & PASSWORD KELUAR -->
                <Border Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔒 " FontSize="16"/>
                            <TextBlock Text="Keamanan &amp; Password Administrator (Pengaturan Server)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Password ini digunakan untuk membuka dan mengubah halaman Pengaturan Server." 
                                   Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,12"/>

                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Password Admin Saat Ini" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CurrentPasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" FontSize="12" BorderBrush="#475569"/>
                            </StackPanel>

                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="Password Admin Baru" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewPasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" FontSize="12" BorderBrush="#475569"/>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Konfirmasi Password Admin Baru" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ConfirmPasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" FontSize="12" BorderBrush="#475569">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ChangePasswordCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </UniformGrid>

                        <Button Command="{Binding ChangePasswordCommand}" 
                                Background="#2563EB" Foreground="#FFFFFF" 
                                Padding="16,8" HorizontalAlignment="Left" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑 " FontSize="12"/>
                                <TextBlock Text="Perbarui Password Pengaturan Server"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CARD 3: GANTI PASSWORD KELUAR APLIKASI -->
                <Border Background="#1E293B" CornerRadius="12" Padding="20,16" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🛡️ " FontSize="16"/>
                            <TextBlock Text="Keamanan &amp; Password Keluar Aplikasi" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Password ini digunakan pengawas/proktor saat menutup atau keluar dari aplikasi." 
                                   Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,12"/>

                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Password Keluar Saat Ini" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CurrentExitPasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" FontSize="12" BorderBrush="#475569"/>
                            </StackPanel>

                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="Password Keluar Baru" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewExitPasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" FontSize="12" BorderBrush="#475569"/>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Konfirmasi Password Keluar Baru" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ConfirmExitPasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="8,6" FontSize="12" BorderBrush="#475569">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ChangeExitPasswordCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </UniformGrid>

                        <Button Command="{Binding ChangeExitPasswordCommand}" 
                                Background="#D97706" Foreground="#FFFFFF" 
                                Padding="16,8" HorizontalAlignment="Left" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑 " FontSize="12"/>
                                <TextBlock Text="Perbarui Password Keluar Aplikasi"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Developer Credit Footer -->
                <TextBlock Text="Developed by Muhipo Dev" 
                           FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,14,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
