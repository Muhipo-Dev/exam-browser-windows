<UserControl x:Class="ExambroMuhipo.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B132B">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="48,32" MaxWidth="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Back Button -->
            <Button Grid.Row="0" Command="{Binding BackToHomeCommand}" HorizontalAlignment="Left"
                    Background="#1E293B" Foreground="#E2E8F0" Padding="14,8" Margin="0,0,0,24"
                    FontSize="12" FontWeight="Bold" BorderBrush="#475569" BorderThickness="1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬅️ " FontSize="12"/>
                    <TextBlock Text="Kembali ke Beranda"/>
                </StackPanel>
            </Button>

            <!-- Header -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,24" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="10" Background="#1E293B" Padding="4" Margin="0,0,16,0" BorderBrush="#334155" BorderThickness="1">
                    <Image Source="/Assets/SchoolLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pengaturan Umum Sistem" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Exambro-Muhipo • SMA Muhammadiyah 1 Ponorogo" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Settings Fields Card -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <!-- Nama Sekolah -->
                    <TextBlock Text="Nama Institusi / Sekolah" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#FFFFFF" Padding="10,6" FontSize="13" BorderBrush="#475569" Margin="0,0,0,16"/>

                    <!-- Logging Options -->
                    <TextBlock Text="Konfigurasi Logging &amp; Audit" Foreground="#F59E0B" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                    <CheckBox Content="Aktifkan Pencatatan Audit Rinci (Detailed Audit Log)" IsChecked="{Binding EnableDetailedAuditLog}" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                    <TextBlock Text="Masa Retensi Berkas Log (Hari)" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#38BDF8" Width="120" HorizontalAlignment="Left" Padding="8,6" FontSize="13" BorderBrush="#475569" Margin="0,0,0,24"/>

                    <!-- Save Button -->
                    <Button Command="{Binding SaveSettingsCommand}" Content="💾 Simpan Pengaturan" HorizontalAlignment="Left"
                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="24,10" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Developer Credit Footer -->
            <TextBlock Grid.Row="3" Text="Developed by Muhipo Dev" 
                       FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" Margin="0,20,0,10"/>
        </Grid>
    </ScrollViewer>
</UserControl>
