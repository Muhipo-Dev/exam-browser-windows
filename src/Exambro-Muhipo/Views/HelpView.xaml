<UserControl x:Class="ExambroMuhipo.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="1050"
             Background="#0B132B">

    <Grid Margin="32,20">
        <Grid.RowDefinitions>
            <!-- 1. Header Bar with Back Button -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Content -->
            <RowDefinition Height="*"/>
            <!-- 3. Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding BackToHomeCommand}" 
                    Background="#1E293B" Foreground="#E2E8F0" 
                    Padding="14,7" FontSize="12" FontWeight="Bold" 
                    BorderBrush="#475569" BorderThickness="1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬅️ " FontSize="11"/>
                    <TextBlock Text="Kembali ke Beranda"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Pusat Bantuan &amp; Panduan" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
            </StackPanel>
        </Grid>

        <!-- 2. Main Content Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="880" HorizontalAlignment="Center" Width="880">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Panduan Peserta Didik (Siswa) -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="👨‍🎓 " FontSize="16"/>
                            <TextBlock Text="Panduan Siswa" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>

                        <TextBlock Text="1. Persiapan Jaringan:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                        <TextBlock Text="Pastikan perangkat terhubung ke Wi-Fi / LAN sekolah sebelum membuka ujian." FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="2. Memulai Ujian:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                        <TextBlock Text="Klik tombol hijau 'MASUK KE UJIAN'. Layar akan otomatis masuk ke Kiosk Mode layar penuh." FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="3. Tata Tertib:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                        <TextBlock Text="Tombol Windows, Alt+Tab, dan shortcut aplikasi dinonaktifkan demi ketertiban ujian." FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="4. Selesai Ujian:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                        <TextBlock Text="Setelah mengirim jawaban, panggil pengawas untuk menutup dan keluar dari aplikasi." FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Column 2: Panduan Operator / Pengawas / Proktor -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🛠️ " FontSize="16"/>
                            <TextBlock Text="Panduan Proktor &amp; Pengawas" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>

                        <TextBlock Text="1. Pengaturan IP Server Ujian:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                        <TextBlock Text="Buka menu 'Pengaturan Server' (password default: admin123). Masukkan IP server ujian dan simpan." FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="2. Keluar Darurat (Emergency Exit):" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                        <TextBlock Text="Tekan 'Alt + F4' saat sesi ujian aktif, lalu masukkan password pengawas untuk keluar dengan aman." FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="3. Pemulihan Sesi (Crash Recovery):" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                        <TextBlock Text="Bila terjadi mati listrik / restart, aplikasi akan menawarkan pemulihan sesi ujian secara instan." FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 3. Footer -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="Developed by Muhipo Dev • SMA Muhammadiyah 1 Ponorogo" 
                       FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
