<UserControl x:Class="ExambroMuhipo.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="1050"
             Background="#0A1128">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Konten Utama: Secure Browser Ujian -->
            <RowDefinition Height="*"/>
            <!-- 3. Bottom Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BANNER -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1.5" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: School Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Source="/Assets/SchoolLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMA MUHAMMADIYAH 1 PONOROGO" FontSize="15" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Secure Examination Browser • Exambro-Muhipo" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Real-time System Clock -->
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="12,6" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕒 " FontSize="12"/>
                        <TextBlock Text="{Binding CurrentTimeString}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Consolas"/>
                        <TextBlock Text=" WIB" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. CENTER CONTENT: COMPACT & ELEGANT SECURE BROWSER CARD -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,12" MaxWidth="720" Width="720">
            <!-- Main Card Container -->
            <Border Background="#0F172A" CornerRadius="14" Padding="28,22" BorderBrush="#1E293B" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.45" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Card Title -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🛡️ " FontSize="18"/>
                            <TextBlock Text="Secure Browser Ujian" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Pastikan perangkat telah terhubung ke server ujian sekolah sebelum memulai." 
                                   FontSize="12.5" Foreground="#94A3B8"/>
                    </StackPanel>

                    <!-- Petunjuk Ringkas & Kompak -->
                    <Border Background="#1E293B" CornerRadius="10" Padding="18,14" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📌 Petunjuk Pelaksanaan Ujian:" FontSize="12.5" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1." FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Klik tombol hijau 'MASUK KE UJIAN' di bawah untuk membuka sesi ujian." Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2." FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Masukkan Nomor Peserta / Akun dan Token ujian yang diberikan oleh pengawas ruang." Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="3." FontWeight="Bold" Foreground="#38BDF8" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Layar otomatis terkunci penuh. Jika mengalami kendala teknis, segera laporkan ke pengawas." Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Main Action Button -->
                    <Button Command="{Binding StartExamCommand}"
                            Padding="40,14" Background="#10B981" Foreground="#FFFFFF"
                            FontSize="17" FontWeight="ExtraBold" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="18" Color="#10B981" Opacity="0.45" ShadowDepth="3"/>
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="▶ " FontSize="16"/>
                            <TextBlock Text="MASUK KE UJIAN" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. BOTTOM UTILITY BAR -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1.5,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SMA Muhammadiyah 1 Ponorogo" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="•" Foreground="#334155" Margin="8,0" FontSize="11"/>
                    <TextBlock Text="{Binding DeveloperCredit}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding OpenAdminCommand}"
                            Background="#1E293B" Foreground="#E2E8F0" 
                            Padding="13,6" Margin="0,0,6,0" FontSize="11.5" FontWeight="Bold" 
                            BorderBrush="#475569" BorderThickness="1" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ " FontSize="11"/>
                            <TextBlock Text="Pengaturan Server"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenAboutCommand}"
                            Background="#1E293B" Foreground="#E2E8F0" 
                            Padding="12,6" Margin="0,0,6,0" FontSize="11.5" FontWeight="Bold" 
                            BorderBrush="#475569" BorderThickness="1" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️ " FontSize="11"/>
                            <TextBlock Text="Tentang"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenHelpCommand}"
                            Background="#1E293B" Foreground="#E2E8F0" 
                            Padding="12,6" Margin="0,0,6,0" FontSize="11.5" FontWeight="Bold" 
                            BorderBrush="#475569" BorderThickness="1" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❓ " FontSize="11"/>
                            <TextBlock Text="Bantuan"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExitAppCommand}"
                            Background="#7F1D1D" Foreground="#FCA5A5" 
                            Padding="12,6" FontSize="11.5" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕ " FontSize="10"/>
                            <TextBlock Text="Keluar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
