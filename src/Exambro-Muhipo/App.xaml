<Application x:Class="ExambroMuhipo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:ExambroMuhipo.Utilities">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <utils:PathToFileNameConverter x:Key="PathToFileNameConverter"/>
        <utils:BoolToStatusBgConverter x:Key="BoolToStatusBgConverter"/>
        <utils:BoolToStatusBorderConverter x:Key="BoolToStatusBorderConverter"/>

        <!-- Global Base Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, sans-serif"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, sans-serif"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, sans-serif"/>
        </Style>

        <!-- Custom Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Application.Resources>
</Application>
